# Field-shipment inputs. Copy this file outside the checkout, fill in real
# values, and source it in the release shell. Never commit completed copies.

# Firmware (heltec_v3 production image)
AKITA_DEVICE_ID=
AKITA_MESH_SERIAL_RX_PIN=
AKITA_MESH_SERIAL_TX_PIN=
AKITA_BLE_SERVICE_UUID=
AKITA_BLE_COT_CHARACTERISTIC_UUID=
AKITA_BLE_WRITE_CHARACTERISTIC_UUID=

# ATAK plugin release packaging
AKITA_ATAK_SDK_JAR=
AKITA_RELEASE_KEYSTORE_FILE=
AKITA_RELEASE_STORE_PASSWORD=
AKITA_RELEASE_KEY_ALIAS=
AKITA_RELEASE_KEY_PASSWORD=

# Optional plugin USB identifiers (defaults exist for Heltec V3)
# AKITA_HELTEC_VENDOR_ID=1027
# AKITA_HELTEC_PRODUCT_ID=24577

# Do not set these for a field shipment:
# AKITA_ALLOW_PLACEHOLDER_SECRET=true
# AKITA_ALLOW_INSECURE_MQTT=true
# AKITA_USE_ATAK_STUB=true
